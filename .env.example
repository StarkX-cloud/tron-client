# TRON server configuration
TRON_HOST=0.0.0.0
TRON_PORT=9000
TRON_RELOAD=false

# Worker bootstrap (see install_tron.sh / install_tron.py)
TRON_MASTER_URL=http://127.0.0.1:9000

# --- Carrier automation (tron.carriers) -------------------------------------
# Verizon ThingSpace / Connectivity Management (official IoT M2M API)
VERIZON_CLIENT_ID=          # OAuth2 app key
VERIZON_CLIENT_SECRET=      # OAuth2 app secret
VERIZON_USERNAME=           # UWS account username (session login)
VERIZON_PASSWORD=           # UWS account password (session login)
VERIZON_ACCOUNT_NAME=       # e.g. 0000123456-00001
# VERIZON_BASE_URL=https://thingspace.verizon.com/api      # override per tenant
# VERIZON_MESSAGING_URL=                                    # A2P gateway, if provisioned

# AT&T IoT / Control Center (official Jasper-based REST API)
ATT_USERNAME=
ATT_API_KEY=
ATT_ACCOUNT_NAME=
# ATT_BASE_URL=https://rws.jasper.com                       # per-tenant rws host (sandbox: rws-jpotest.jasper.com)
# ATT_MESSAGING_URL=                                        # enterprise messaging, if provisioned

# T-Mobile IoT / Control Center (official IoT API)
TMOBILE_CLIENT_ID=
TMOBILE_CLIENT_SECRET=
TMOBILE_ACCOUNT_NAME=
# TMOBILE_BASE_URL=https://iot.api.t-mobile.com               # override per tenant
# TMOBILE_MESSAGING_URL=                                       # enterprise messaging, if provisioned
