# TRON server configuration
TRON_HOST=0.0.0.0
TRON_PORT=9000
TRON_RELOAD=false

# Worker bootstrap (see install_tron.sh / install_tron.py)
TRON_MASTER_URL=http://127.0.0.1:9000
TRON_WORKER_NAME=worker-1
TRON_WORKER_SKU=g6-nanode-1
TRON_WORKER_HOURLY_RATE=0.0075

# Production auth (Prompt 4) — set in real deployments
TRON_SUBMIT_AUTH_TOKEN=
TRON_AUTOPILOT_API_TOKEN=
TRON_AUTOPILOT_URL=http://127.0.0.1:9100

# Optional ledgers / registries
TRON_PROVIDER_REGISTRY=tron_providers.json
TRON_PROVIDER_STATS=tron_provider_stats.jsonl
TRON_USAGE_LEDGER=tron_usage.jsonl
TRON_AUTOPILOT_LOG=tron_autopilot_decisions.jsonl
TRON_AUTOPILOT_HISTORY=tron_autopilot_history.json

# Optional dedicated provisioner
# TRON_DEDICATED_PROVISIONER=linode
# LINODE_TOKEN=
